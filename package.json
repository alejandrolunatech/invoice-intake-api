{
  "name": "invoice-intake-api",
  "version": "1.0.0",
  "private": true,
  "description": "Invoice intake API: a language model extracts the fields, TypeScript code verifies them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/adapters/db/migrations dist/adapters/db/",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "eval:live": "EVAL_LIVE=1 vitest run --project eval",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "express": "5.3.0",
    "openai": "7.39.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
